from docker.io/ubuntu:25.10

# Setting the working directory inside the container
WORKDIR /webapp

# Variable VERSION
ARG VERSION

# Setting Label Schema Convention with version
LABEL org.label-schema.version=$VERSION

# Copy files from the current directory to the container working directory
COPY ./requirements.txt .

# Update system, installing python, pip, packages and clean apt-get lists
RUN apt-get update && \
    apt-get -y install python3.13-full --no-install-recommends && \
    apt-get -y install pip --no-install-recommends && \
    pip install -r requirements.txt --break-system-packages --no-cache-dir && \
    rm -rf /var/lib/apt/lists/*


CMD ["fastapi", "run", "app.py", "--port", "8000"]