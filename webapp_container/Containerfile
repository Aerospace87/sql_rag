from localhost/sql_rag_dev_base

WORKDIR /webapp

# Copy files from the current directory to the container working directory
COPY ./requirements-extra.txt .
 
# Install packages and clean apt-get lists   
RUN pip install -r requirements-extra.txt --break-system-packages && \
    rm -rf /var/lib/apt/lists/*


CMD ["fastapi", "run", "app.py", "--port", "8000"]
